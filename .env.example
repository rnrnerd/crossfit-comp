# ── Соревновательный ТМА: переменные окружения ──────────────────────
# Скопируй в Railway → Variables. Локально можно создать файл .env.

# Токен НОВОГО тестового бота (BotFather). Без него поднимется только API.
BOT_TOKEN=

# Публичный URL фронта (GitHub Pages нового репозитория), напр.:
# https://<твой-логин>.github.io/crossfit-comp/
WEBAPP_URL=

# PostgreSQL (Railway → плагин Postgres даёт DATABASE_URL).
# Пусто → сервис отдаёт демо-данные из sample_data.py.
DATABASE_URL=

# Пароль для входа в админ-панель (/admin). ОБЯЗАТЕЛЬНО смени на проде!
ADMIN_PASSWORD=admin123

# PORT задаёт Railway автоматически. Локально по умолчанию 8080.
# PORT=8080
